# Local secrets — never commit. The Meshy MCP server reads .env and .env.local
# from its working directory, and add-mcp's project-scope install writes the
# API key straight into .mcp.json. The key belongs in ~/.claude.json only.
.env
.env.local
.mcp.json

# Raw Meshy output: tens of MB each. Regenerate from source/input/ and
# the parameters in source/GENERATION_LOG.md instead of committing these.
assets/models/dokkaebi/source/*.glb
assets/models/dokkaebi/source/*_base_color.png
