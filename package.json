{
  "name": "eungarage-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EUNGARAGE \u2014 DOKKA CREW workshop site",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && vite build",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "outline:proof": "node scripts/outline-proof.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
